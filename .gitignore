# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# sensitive / local data
secrets/
data/

# scaffold temp dir
scaffold-tmp/

# auto-generated by Next.js
next-env.d.ts

certificates
.superpowers/

# Impeccable : on garde le système de design et la composition approuvée,
# pas les brouillons ni les captures de contrôle.
.impeccable/shots/
.impeccable/sketches/
.impeccable/questions/
.impeccable/hook.cache.json
.impeccable/*-payload.json
.impeccable/qb-*.webp
.impeccable/mocks/comp-a-*
.impeccable/mocks/comp-c-*

# Mode live d'impeccable : journaux de session, propres à une machine.
.impeccable/live/sessions/
.impeccable/live/accept-receipts/
.impeccable/live/roots.json
