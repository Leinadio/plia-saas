# Enable Banking application ID (from the Control Panel)
ENABLEBANKING_APPLICATION_ID=
# Path to the downloaded RSA private key (.pem)
ENABLEBANKING_KEY_PATH=./secrets/private_key.pem
# Redirect URL registered in the Control Panel
ENABLEBANKING_REDIRECT_URL=http://localhost:3000/api/callback

# Connexion Google facultative — voir docs/google-auth.md.
# Ajouter ces valeurs côté serveur ; ne jamais utiliser NEXT_PUBLIC.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_URL doit correspondre à l’origine de l’application.
# En développement HTTPS : https://localhost:3000
# Retour à autoriser chez Google : https://localhost:3000/api/auth/callback/google
